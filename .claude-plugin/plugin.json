{
  "name": "git-graph",
  "version": "0.3.36",
  "displayName": "Git Graph",
  "description": "A Git Graph pane for Claude Code: branches, tags, remotes and each commit's details, refreshed after every turn.",
  "author": {
    "name": "Alvaro Muñoz",
    "url": "https://github.com/alvaromunozmx"
  },
  "homepage": "https://github.com/alvaromunozmx/git-graph-claude",
  "repository": "https://github.com/alvaromunozmx/git-graph-claude",
  "documentationUrl": "https://github.com/alvaromunozmx/git-graph-claude#readme",
  "supportUrl": "https://github.com/alvaromunozmx/git-graph-claude/issues/new/choose",
  "privacyPolicyUrl": "https://github.com/alvaromunozmx/git-graph-claude/blob/main/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/alvaromunozmx/git-graph-claude/blob/main/LICENSE",
  "license": "MIT",
  "keywords": [
    "git",
    "graph",
    "history",
    "branches",
    "mod"
  ],
  "types": "./types/index.d.ts",
  "userConfig": {
    "limit": {
      "type": "string",
      "title": "Commits to show",
      "description": "How many commits the graph loads.",
      "default": "150"
    }
  }
}
